# sample.env — copy to .env and fill in your values

# Generate a strong key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your_secret_key

DATABASE_URL=your_database_url

# Yahoo SMTP credentials for contact form emails
MAIL_USERNAME=your_yahoo_email@yahoo.com
MAIL_PASSWORD=your_yahoo_app_password
SUBJECT=New Contact Form Submission
RECIPIENT=your_receiving_email@example.com
